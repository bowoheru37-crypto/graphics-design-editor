# Environment variables example for creativity-platform

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_strong_random_secret_here

# MongoDB (used by docker-compose)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=creativity

# Redis (for token blacklist, sessions)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS (if used)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
