  upload() { Toast.show('Asset upload dialog', 'inf'); Log.add('Upload requested', 'inf'); },
  addPhys(t) { Toast.show(`Added ${esc(t)}`, 'ok'); Log.add(`Physics: ${esc(t)}`, 'ok'); },
  _buildHTML() {
    const els = $$('.felem');
    let body = '';
    els.forEach(el => {
      const l = el.style.left, t = el.style.top, tp = esc(el.dataset.type || 'div'), bg = el.style.background || 'var(--bg-3)';
      body += `<div style="position:absolute;left:${l};top:${t};padding:10px 14px;background:${bg};border-radius:6px;color:#fff;font-family:sans-serif;font-size:13px;font-weight:600;box-shadow:0 2px 6px rgba(0,0,0,0.3)">${tp}</div>`;
    });
    return `<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(State.proj.name)}</title><style>body{margin:0;background:#08080f;color:#fff;font-family:sans-serif;overflow:hidden}</style></head><body><div style="position:relative;width:100vw;height:100vh">${body || '<div style="display:flex;align-items:center;justify-content:center;height:100vh;color:#64748b">AETHER Project Preview</div>'}</div></body></html>`;
  },
  preview() {
    const html = this._buildHTML();
    const w = window.open('about:blank', '_blank');
    if (w) { w.document.open(); w.document.write(html); w.document.close(); Toast.show('Preview opened', 'ok'); Log.add('Preview opened', 'ok'); }
    else { Toast.show('Popup blocked', 'er'); }
  },
  export() {
    const html = this._buildHTML();
    const blob = new Blob([html], { type: 'text/html' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = State.proj.name + '.html';
    a.click();
    URL.revokeObjectURL(url);
    Toast.show('Exported!', 'ok');
    Log.add('Project exported', 'ok');
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// CONTEXT MENU
// ═══════════════════════════════════════════════════════════════════════════════
const Ctx = {
  init() {
    const m = $('#ctx');
    let lp;
    on(document, 'contextmenu', (e) => {
      if (e.target.closest('.felem') || e.target.closest('.canvas')) {
        e.preventDefault();
        this.show(e.clientX, e.clientY);
      }
    });
    on(document, 'click', () => m.classList.remove('on'));
    on(document, 'touchstart', (e) => {
      if (e.touches.length === 1) lp = setTimeout(() => { const t = e.touches[0]; this.show(t.clientX, t.clientY); }, 600);
    }, { passive: true });
    on(document, 'touchend', () => clearTimeout(lp));
    on(document, 'touchmove', () => clearTimeout(lp));
  },
  show(x, y) {
    const m = $('#ctx');
    m.style.left = clamp(x, 0, window.innerWidth - 160) + 'px';
    m.style.top = clamp(y, 0, window.innerHeight - 200) + 'px';
    m.classList.add('on');
  },
  copy() { Toast.show('Copied', 'ok'); },
  paste() { Toast.show('Pasted', 'ok'); },
  dup() { Toast.show('Duplicated', 'ok'); },
  group() { Toast.show('Grouped', 'inf'); },
  lock() { Toast.show('Locked', 'inf'); },
  del() {
    $$('.felem.sel').forEach(el => { el.remove(); Actions.save(); });
    Toast.show('Deleted', 'er');
    Log.add('Deleted selection', 'er');
    State.modified = true;
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// GESTURES
// ═══════════════════════════════════════════════════════════════════════════════
const Gestures = {
  init() {
    const ca = $('#canvas');
    let d0 = 0, z0 = 1;
    on(ca, 'touchstart', (e) => {
      if (e.touches.length === 2) {
        d0 = Math.hypot(e.touches[0].pageX - e.touches[1].pageX, e.touches[0].pageY - e.touches[1].pageY);
        z0 = State.zoom;
      }
    }, { passive: true });
    on(ca, 'touchmove', (e) => {
      if (e.touches.length === 2 && d0 > 0) {
        const d1 = Math.hypot(e.touches[0].pageX - e.touches[1].pageX, e.touches[0].pageY - e.touches[1].pageY);
        State.zoom = clamp(z0 * (d1 / d0), 0.25, 4);
        Canvas.apply();
      }
    }, { passive: true });
    on(ca, 'touchend', () => { d0 = 0; });
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// KEYBOARD
// ═══════════════════════════════════════════════════════════════════════════════
const Keyboard = {
  init() {
    on(document, 'keydown', (e) => {
      if (e.key === 'Delete' || e.key === 'Backspace') {
        const s = $$('.felem.sel');
        if (s.length) { s.forEach(el => el.remove()); Actions.save(); Toast.show('Deleted', 'er'); Log.add('Deleted', 'er'); State.modified = true; }
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'z') { e.preventDefault(); Actions.undo(); }
      if ((e.metaKey || e.ctrlKey) && e.key === 's') { e.preventDefault(); Project.save(); }
      if ((e.metaKey || e.ctrlKey) && e.key === '`') { e.preventDefault(); UI.toggle('codePanel'); }
      if ((e.metaKey || e.ctrlKey) && e.key === 'j') { e.preventDefault(); UI.toggle('consolePanel'); }
      if ((e.metaKey || e.ctrlKey) && e.key === 'n') { e.preventDefault(); UI.toggle('nodePanel'); }
      if (e.key === 'Escape') {
        $$('.fpanel').forEach(p => p.classList.remove('on'));
        $$('.btn-ic').forEach(b => b.classList.remove('on'));
        $('#ctx').classList.remove('on');
      }
    });
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════════════════════════════════════
const Toast = {
  _t: null,
  show(msg, type = 'inf') {
    const t = $('#toast'), tx = $('#ttxt');
    t.className = 'toast ' + type;
    tx.textContent = msg;
    t.classList.add('on');
    if (this._t) clearTimeout(this._t);
    this._t = setTimeout(() => t.classList.remove('on'), CFG.toast);
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// CONSOLE / LOG
// ═══════════════════════════════════════════════════════════════════════════════
const Log = {
  add(msg, type = 'inf') {
    const b = $('#conb');
    const d = document.createElement('div');
    d.className = type;
    d.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
    b.appendChild(d);
    b.scrollTop = b.scrollHeight;
    State.cons.push({ msg, type, time: Date.now() });
  }
};
const Console = {
  clear() { $('#conb').innerHTML = ''; Toast.show('Console cleared', 'inf'); }
};

// ═══════════════════════════════════════════════════════════════════════════════
// CLOCK
// ═══════════════════════════════════════════════════════════════════════════════
const Clock = {
  init() {
    const up = () => {
      const el = $('#clock');
      if (el) { const n = new Date(); el.textContent = n.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false }); }
    };
    up();
    setInterval(up, 60000);
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// SHADER PREVIEW (WebGL2) — with cleanup
// ═══════════════════════════════════════════════════════════════════════════════
const ShaderPreview = {
  raf: null,
  init() {
    const c = $('#shaderCanvas');
    if (!c) return;
    const gl = c.getContext('webgl2');
    if (!gl) return;
    const resize = () => {
      const r = c.parentElement.getBoundingClientRect();
      c.width = r.width; c.height = r.height;
      gl.viewport(0, 0, c.width, c.height);
    };
    resize();
    window.addEventListener('resize', resize);
    const vs = `#version 300 es
in vec2 aPosition;
void main(){gl_Position=vec4(aPosition,0.0,1.0);}`;
    const fs = `#version 300 es
precision highp float;
out vec4 oColor;
uniform float uTime;
void main(){vec2 uv=gl_FragCoord.xy/vec2(400.0,120.0);vec3 c=vec3(0.5+0.5*sin(uTime+uv.x*3.14),0.5+0.5*sin(uTime+uv.y*3.14+2.09),0.5+0.5*sin(uTime+4.18));oColor=vec4(c,1.0);}`;
    const compile = (t, s) => { const sh = gl.createShader(t); gl.shaderSource(sh, s); gl.compileShader(sh); return sh; };
    const prog = gl.createProgram();
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog); gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,1,-1,-1,1,1,1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'aPosition');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const uloc = gl.getUniformLocation(prog, 'uTime');
    const render = (t) => { gl.uniform1f(uloc, t * 0.001); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); this.raf = requestAnimationFrame(render); };
    this.raf = requestAnimationFrame(render);
  },
  destroy() { if (this.raf) cancelAnimationFrame(this.raf); }
};

// ═══════════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════
on(document, 'DOMContentLoaded', () => {
  Splash.init();
  Ctx.init();
  Gestures.init();
  Keyboard.init();
  Clock.init();
  ShaderPreview.init();
});
</script>
