<span class="kw">class</span> <span class="ty">Player</span> <span class="kw">extends</span> <span class="ty">Entity</span> {
  <span class="fn">constructor</span>() {
    <span class="kw">super</span>();
    <span class="kw">this</span>.<span class="fn">transform</span> = <span class="kw">new</span> <span class="ty">Transform</span>();
    <span class="kw">this</span>.<span class="fn">velocity</span> = <span class="kw">new</span> <span class="ty">Vec3</span>(<span class="nu">0</span>, <span class="nu">0</span>, <span class="nu">0</span>);
    <span class="kw">this</span>.<span class="fn">input</span> = <span class="kw">new</span> <span class="ty">PlayerInput</span>();
  }

  <span class="fn">update</span>(<span class="fn">dt</span>) {
    <span class="kw">const</span> <span class="fn">dir</span> = <span class="kw">this</span>.<span class="fn">input</span>.<span class="fn">getDirection</span>();
    <span class="kw">this</span>.<span class="fn">velocity</span> = <span class="fn">dir</span>.<span class="fn">scale</span>(<span class="nu">5.0</span>);
