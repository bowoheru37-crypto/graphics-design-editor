const UI = {
  toggle(id) {
    const el = $(`#${id}`);
    if (!el) return;
    const isOn = el.classList.contains('on');
    if (!isOn) {
      // Close other floating panels to prevent overlap clutter
      $$('.fpanel').forEach(p => { if (p.id !== id && p.id !== 'consolePanel' && p.id !== 'codePanel') p.classList.remove('on'); });
    }
    el.classList.toggle('on');
    const map = { codePanel: 'btnCode', nodePanel: 'btnNode', consolePanel: 'btnCon', shaderPanel: 'btnShader', gitPanel: 'btnGit', pkgPanel: 'btnPkg', profPanel: 'btnProf' };
    if (map[id]) { const btn = $(`#${map[id]}`); if (btn) btn.classList.toggle('on', !isOn); }
    // Ensure panel stays within viewport bounds
    if (!isOn && el.classList.contains('fpanel')) this.constrain(el);
  },
  constrain(el) {
    const r = el.getBoundingClientRect();
    const vw = window.innerWidth, vh = window.innerHeight;
    let l = parseInt(el.style.left) || 60, t = parseInt(el.style.top) || 60;
    if (l + r.width > vw) l = Math.max(10, vw - r.width - 10);
    if (t + r.height > vh) t = Math.max(10, vh - r.height - 10);
    el.style.left = l + 'px';
    el.style.top = t + 'px';
  },
  layer() { Toast.show('New layer created', 'ok'); }
};

