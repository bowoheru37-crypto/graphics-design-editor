}
.ctx.on { display: flex; }
.cxi {
  padding: 6px 8px;
  border-radius: 5px;
  font-size: 11px;
  cursor: pointer;
  transition: all var(--tf);
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--t2);
  touch-action: manipulation;
}
.cxi:hover { background: var(--bg-4); color: var(--t1); }
.cxi i { font-size: 12px; width: 14px; text-align: center; font-style: normal; }
.cxd { height: 1px; background: var(--b1); margin: 2px 0; }

