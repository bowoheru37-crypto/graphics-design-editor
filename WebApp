<span class="kw">import</span> { <span class="fn">Shader</span>, <span class="fn">Material</span>, <span class="fn">Mesh</span> } <span class="kw">from</span> <span class="st">'aether-gfx'</span>;
<span class="kw">import</span> { <span class="fn">Audio</span>, <span class="fn">Synth</span>, <span class="fn">Sampler</span> } <span class="kw">from</span> <span class="st">'aether-audio'</span>;
