<span class="kw">import</span> { <span class="fn">ML</span>, <span class="fn">Tensor</span>, <span class="fn">Model</span> } <span class="kw">from</span> <span class="st">'aether-ml'</span>;

<span class="kw">const</span> <span class="fn">engine</span> = <span class="kw">new</span> <span class="ty">Engine</span>({
  <span class="fn">target</span>: <span class="st">'webgl2'</span>,
  <span class="fn">physics</span>: <span class="st">'wasm-bullet'</span>,
