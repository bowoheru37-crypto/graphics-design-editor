// ─── Global Drag Manager (prevents listener leaks) ───
(function() {
  let dragEl = null, dragOff = { x: 0, y: 0 };
  const onMove = (e) => {
    if (!dragEl) return;
    const c = e.touches ? e.touches[0] : e;
    let nx = c.clientX - dragOff.x, ny = c.clientY - dragOff.y;
    if (CFG.snap > 0) { nx = Math.round(nx / CFG.grid) * CFG.grid; ny = Math.round(ny / CFG.grid) * CFG.grid; }
    dragEl.style.left = nx + 'px';
    dragEl.style.top = ny + 'px';
    if (e.cancelable) e.preventDefault();
  };
  const onEnd = () => {
    if (!dragEl) return;
    dragEl.style.zIndex = '';
    dragEl.style.willChange = '';
    dragEl = null;
    Actions.save();
    State.modified = true;
  };
  on(document, 'mousemove', onMove);
  on(document, 'mouseup', onEnd);
  on(document, 'touchmove', onMove, { passive: false });
  on(document, 'touchend', onEnd);

  // Delegate mousedown for drag handles
  on($('#dcontent'), 'mousedown', (e) => {
    const h = e.target.closest('.fhandle');
    if (!h) return;
    const el = h.closest('.felem');
    if (!el) return;
    dragEl = el;
    const c = e.touches ? e.touches[0] : e;
    const rect = el.getBoundingClientRect();
    const parent = el.offsetParent.getBoundingClientRect();
    dragOff.x = c.clientX - (rect.left - parent.left);
    dragOff.y = c.clientY - (rect.top - parent.top);
    el.style.zIndex = 100;
    el.style.willChange = 'transform, left, top';
    if (e.cancelable) e.preventDefault();
  });
  on($('#dcontent'), 'touchstart', (e) => {
    const h = e.target.closest('.fhandle');
    if (!h) return;
    const el = h.closest('.felem');
    if (!el) return;
    dragEl = el;
    const c = e.touches[0];
    const rect = el.getBoundingClientRect();
    const parent = el.offsetParent.getBoundingClientRect();
    dragOff.x = c.clientX - (rect.left - parent.left);
    dragOff.y = c.clientY - (rect.top - parent.top);
    el.style.zIndex = 100;
    el.style.willChange = 'transform, left, top';
  }, { passive: false });
})();

