{
  "name": "creativity-platform-backend",
  "version": "1.0.0",
  "description": "Backend for next-generation creative development platform",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1486.0",
    "socket.io": "^4.7.2",
    "redis": "^4.6.10",
    "axios": "^1.6.0",
    "stripe": "^14.14.0",
    "nodemailer": "^6.9.6",
    "joi": "^17.10.2",
    "class-validator": "^0.14.0",
    "uuid": "^9.0.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/mongoose": "^7.0.9",
    "typescript": "^5.0.2",
    "ts-node-dev": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.44.0",
    "prettier": "^3.0.0",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.2",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
